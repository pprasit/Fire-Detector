[Unit]
Description=Fetch Fire Detector MediaMTX publisher credentials
Wants=network-online.target
After=network-online.target tailscaled.service

[Service]
Type=oneshot
User=pi
Group=pi
RuntimeDirectory=fire-detector-stream
RuntimeDirectoryMode=0700
WorkingDirectory=/home/pi/Public/Fire-Detector
ExecStart=/home/pi/Public/Fire-Detector/.venv/bin/python /home/pi/Public/Fire-Detector/scripts/fetch_stream_credentials.py
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
