[Unit]
Description=Fire Detector simulated visible camera stream
Wants=network-online.target
After=network-online.target fire-detector.service
Requires=fire-detector.service

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/Public/Fire-Detector
ExecStart=/home/pi/Public/Fire-Detector/.venv/bin/python /home/pi/Public/Fire-Detector/scripts/upload_simulated_thermal_frame.py --camera visible --loop --interval 0.2
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
