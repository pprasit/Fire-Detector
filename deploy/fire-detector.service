[Unit]
Description=Fire Detector ODrive dashboard
Wants=network-online.target
After=network-online.target avahi-daemon.service

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/Public/Fire-Detector
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/pi/Public/Fire-Detector/.venv/bin/python /home/pi/Public/Fire-Detector/scripts/run_monitor.py --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
