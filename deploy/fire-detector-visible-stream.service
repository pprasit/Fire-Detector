[Unit]
Description=Publish simulated visible H.264 stream to MediaMTX
Wants=network-online.target
After=network-online.target tailscaled.service fire-detector-stream-credentials.service
Requires=fire-detector-stream-credentials.service

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/Public/Fire-Detector
EnvironmentFile=/run/fire-detector-stream/publisher.env
ExecStart=/home/pi/Public/Fire-Detector/.venv/bin/python /home/pi/Public/Fire-Detector/scripts/publish_simulated_stream.py --camera visible
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
